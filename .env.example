# Sourced Nexus — Environment Variables
# For local dev, Vercel, and Render deployments

# Base44 Backend
VITE_BASE44_APP_ID=6abc6a8a4b6c9d175aa35566
VITE_BASE44_APP_BASE_URL=https://base44.app
VITE_BASE44_SERVER_URL=https://base44.app

# Optional Supabase Database & Image Storage
# (Apply migrations in ./supabase/migrations first)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Lenco Payments (BroadPay) — server-side secrets, NEVER expose to the frontend
# Public key is returned to the browser only via the create-order API response.
LENCO_PUBLIC_KEY=your-lenco-public-key
LENCO_SECRET_KEY=your-lenco-secret-key
# Optional override; defaults to sha256(LENCO_SECRET_KEY) per Lenco docs
LENCO_WEBHOOK_HASH=
# production | sandbox (sandbox uses pay.sandbox.lenco.co widget and test data)
LENCO_ENV=production
# Server-side Supabase key used by /api endpoints (inquiries + Lenco payments).
# Must NEVER be a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
