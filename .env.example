# Sourced Nexus — Environment Variables
# For local dev, Vercel, and Render deployments

# Base44 Backend
VITE_BASE44_APP_ID=6abc6a8a4b6c9d175aa35566
VITE_BASE44_APP_BASE_URL=https://base44.app
VITE_BASE44_SERVER_URL=https://base44.app

# Optional Supabase Database & Image Storage
# (Apply migrations in ./supabase/migrations first)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Payza payments (payzaapi.co.ke) — server-side secrets, NEVER expose to the
# frontend. The customer is redirected to Payza's hosted checkout, so no
# public key is used in the browser.
PAYZA_PUBLIC_KEY=your-payza-public-key
PAYZA_SECRET_KEY=your-payza-secret-key
# Webhook Signing Secret (Dashboard -> API keys -> Webhook Signing Secret);
# separate from the API keys. Used to verify X-Payza-Signature.
PAYZA_WEBHOOK_SECRET=your-payza-webhook-signing-secret
# Public origin of the deployed site, used to build Payza's callback /
# redirect / cancel URLs. Falls back to the request's Host header.
SITE_BASE_URL=https://your-production-domain

# Server-side Supabase key used by /api endpoints (inquiries + Payza payments).
# Must NEVER be a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
