{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/notifications/process",
      "destination": "/api/notifications-process"
    },
    {
      "source": "/api/announcements/process",
      "destination": "/api/announcements-process"
    },
    {
      "source": "/api/payments/payza/create-order",
      "destination": "/api/payza-create-order"
    },
    {
      "source": "/api/payments/payza/verify",
      "destination": "/api/payza-verify"
    },
    {
      "source": "/api/payments/payza/cancel",
      "destination": "/api/payza-cancel"
    },
    {
      "source": "/api/webhooks/payza",
      "destination": "/api/payza-webhook"
    },
    {
      "source": "/product/:param",
      "destination": "/api/product-page?p=:param"
    },
    {
      "source": "/api/shop/:path*",
      "destination": "/api/shop?p=:path*"
    },
    {
      "source": "/api/apps/:path*",
      "destination": "https://base44.app/api/apps/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-BDMpuMcDb5YTofzHKCyxRsGrrtWIgNEfj8D+2GXOr4w=' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://*.base44.com https://images.unsplash.com https://*.googleusercontent.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.base44.com https://base44.app https://api.base44.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com https://*.supabase.co; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/process",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/announcements/process",
      "schedule": "5 6 * * *"
    },
    {
      "path": "/api/shop/receipts/process",
      "schedule": "10 6 * * *"
    }
  ]
}
